# ============================================================================
#  Store Bot — config.env  (ঐচ্ছিক ফাইল)
#  এই ফাইল কপি করে `config.env` বানান। ফাইলটি git-ignored — টোকেন কমিট হবে না।
# ============================================================================
#
#  🔴 যা এখানে দিতেই হবে (এটুকুই):
#       API_ID, API_HASH, BOT_TOKEN, ADMIN_IDS
#      (ওয়েব login password web/dashboard.py-তে source constant হিসেবে আছে)
#
#  🟢 বাকি সব সেটিংস (ফোর্স-জয়েন চ্যানেল, পেমেন্ট নাম্বার, সাপোর্ট কন্টাক্ট,
#     ক্যাপশন, ব্রডকাস্ট গতি, সাইটের নাম …) এখন **ওয়েবসাইটের অ্যাডমিন প্যানেল**
#     (⚙️ Settings) বা **বটের ⚙️ Settings** থেকে করা যায় — ডেটাবেজে সেভ হয়,
#     রিস্টার্ট লাগে না।
#
#  নিয়ম: প্যানেল থেকে সেভ করা মান  >  এই ফাইলের মান  >  কোডের ডিফল্ট।
#     মানে নিচের যেকোনো লাইন এখানেও রাখতে পারেন (দরকার হলে), প্যানেল সেটা
#     ওভাররাইড করে নেবে। পুরো লিস্ট: `README.md` → ⚙️ সেটিংস।
# ============================================================================

# ---------- বাধ্যতামূলক (এই চারটি ছাড়া বট চলবে না) ----------
API_ID=<my.telegram.org থেকে>
API_HASH=<my.telegram.org থেকে>
BOT_TOKEN=<BotFather থেকে — নতুন রিভোক করা টোকেন>
ADMIN_IDS=123456789,987654321
# প্রথম আইডিটাই "প্রাইমারি অ্যাডমিন" — সব অ্যালার্ট/রিপোর্ট ওখানেই যায়।

# ---------- ওয়েবসাইট / অ্যাডমিন প্যানেল (খুবই সুপারিশকৃত) ----------
WEB_TITLE=Desi Site
SITE_URL=https://codenestauth5.onrender.com/live/u3-esi-38a23a
# হোস্টিং প্যানেল যে PORT দেয় সেটাই ব্যবহৃত হয়; লোকালি চাইলে বদলান
# PORT=8080
# 0.0.0.0 = বাইরে থেকেও খোলা (প্যানেলের লাইভ লিঙ্কের জন্য এটাই দরকার)
# WEB_HOST=0.0.0.0
# WEB_ENABLED=true               # ডিফল্ট এখন true; $PORT থাকলে হোস্টেড জবে সবসময় চালু
# WEB_SESSION_HOURS=72
# SITE_ENABLED=true
# SITE_TAGLINE=এক ট্যাপে ফাইল, সিরিজ আর ভিডিও — টেলিগ্রাম বট থেকে সাথে সাথে ডেলিভারি।

# ---------- ঐচ্ছিক: সেশন ----------
# আগে থেকে বানানো userbot string session (প্রাইভেট চ্যানেলের ফাইল পাঠাতে লাগে)
# STRING_SESSION=

# ============================================================================
#  নিচের সবগুলোই 🟢 ঐচ্ছিক — চাইলে প্যানেল/ওয়েবসাইট থেকেই সেট করুন
# ============================================================================

# ---------- চ্যানেল জয়েন (Force Join) ----------
# @username, t.me লিংক, প্রাইভেট ইনভাইট লিংক (t.me/+…), এমনকি চ্যানেল আইডি — সব চলবে।
# FORCE_CHANNEL=@mychannel
# FORCE_JOIN_ENABLED=true
# FORCE_JOIN_NOTE=জয়েন করে আবার /start দিন
# FORCE_JOIN_CACHE_SECONDS=600
# FORCE_JOIN_ALWAYS=true         # ডিফল্ট চ্যানেল কি সব স্টোরেও বাধ্যতামূলক
# FORCE_JOIN_EXTRA=              # অতিরিক্ত চ্যানেল, কমা/নতুন লাইনে (@a, https://t.me/+…)
#                                # স্টোর-ভিত্তিক আলাদা চ্যানেল: /admin/stores/<id> বা বটে 📢 আলাদা চ্যানেল

# ---------- পেমেন্ট ----------
# CURRENCY=৳
# PAY_BKASH=01712-345678
# PAY_NAGAD=
# PAY_ROCKET=
# PAY_UPI=
# PAY_CRYPTO=
# PAY_NOTE=
# TRIAL_HOURS=24                # 0 দিলে ফ্রি ট্রায়াল বন্ধ
# AUTO_APPROVE_ZERO=true        # ফ্রি প্ল্যান অটো-অ্যাপ্রুভ

# ---------- সাপোর্ট / যোগাযোগ ----------
# SUPPORT_CONTACT=@myusername
# SUPPORT_NOTE=সকাল ১০টা – রাত ১০টা
# TICKET_COOLDOWN=60

# ---------- কনটেন্ট ও ভাষা ----------
# CUSTOM_CAPTION=                # {name} দিলে ফাইলের নাম বসবে
# DEFAULT_LANG=bn                # bn বা en
# CONTENT_MEDIA_KINDS=video,photo   # স্টোরে কী গ্রহণযোগ্য — টেক্সট কখনোই সেভ হয় না
# STORAGE_CHANNEL=               # মিডিয়া ক্যাশ চ্যানেল (@channel বা -100…) — ঐচ্ছিক
# MIRROR_MAX_MB=1900             # এর চেয়ে বড় ফাইল ক্যাশ করা হয় না (Telegram সীমা ২০০০)
# LINK_DEFAULT_LIMIT=100         # লিমিটেড লিংকের ডিফল্ট ক্লিক সংখ্যা (0 = আনলিমিটেড)

# ---------- হোম পেজের অটো-প্লে রিল ও ওয়াল ----------
# FEED_ENABLED=true              # হোম পেজে সদ্য যোগ হওয়া ফ্রি ভিডিও/ছবি (অটো-প্লে)
# FEED_COUNT=4                   # রিলে কয়টা মিডিয়া (১–৮)
# FEED_WALL=4                    # একসাথে কয়টা ভিডিও নিজে নিজেই চলবে (০ = বন্ধ)
# FEED_AUTOPLAY=true             # মিউট অটোপ্লে; ব্রাউজার আনমিউট অটোপ্লে আটকে দেয়
# FEED_MUTED=true                # শুরুতে সাউন্ড বন্ধ (বাটনে চালু করা যায়)
# FEED_LOOP=true                 # শেষ হলে আবার শুরু
# FEED_GALLERY_COUNT=36          # /watch পেজে কতগুলো মিডিয়া (৪–১২০)
# FEED_CACHE_DIR=.cache/thumbs   # থাম্বনেইল ডিস্ক-ক্যাশের ফোল্ডার
# FEED_DEMO_DIR=demo_media       # প্রিভিউ মোডের নমুনা ক্লিপ (tools/seed_demo.py)
# BROADCAST_SEND_ONLINE_BUTTON=true  # ব্রডকাস্টে “🟢 অনলাইন — স্টোর খুলুন” বাটন

# ---------- ব্রডকাস্ট স্টুডিও ----------
# BROADCAST_MAX_FILES=5          # এক মেসেজে সর্বোচ্চ ফাইল
# BROADCAST_AUTO_RESUME=true     # রিস্টার্টে মাঝপথে থেমে যাওয়া campaign resume; queued campaign সবসময় শুরু হবে
# BROADCAST_REACH_DAYS=0         # 0 = সব ইউজার; নাহলে শেষ N দিনে সক্রিয় ইউজার
# BROADCAST_BATCH=25             # এক ব্যাচে কতজনকে (Telegram-এর সীমা ~৩০ মেসেজ/সেকেন্ড)
# BROADCAST_BATCH_PAUSE=1.0      # প্রতি ব্যাচের পরে কত সেকেন্ড বিরতি
# BROADCAST_ADAPTIVE=true        # 429/FloodWait পেলে বাকি ব্রডকাস্ট নিজে থেকেই ধীরে চলবে
# AUTO_STORE_PUBLISH_CHANNEL=false  # নতুন স্টোর বানালেই আলাদা পাবলিশ চ্যানেল
# BROADCAST_TO_BLOCKED=false
# BROADCAST_ONLINE_LABEL=🟢 অনলাইন — স্টোর খুলুন
# BROADCAST_DEFAULT_BUTTONS=     # প্রতি ব্রডকাস্টে বাটন: “লেবেল | https://লিংক”
#                                # একই লাইনে && দিলে পাশাপাশি; /admin/broadcast-এও লেখা যায়
# CHANNEL_POST_FOOTER=           # প্রতিটি চ্যানেল পোস্টের নিচের ফিক্সড লেখা
# DIGEST_ENABLED=false           # সাপ্তাহিক নতুন-ভিডিও ডাইজেস্ট চালু/বন্ধ
# DIGEST_WEEKDAY=4               # 0=সোম … 6=রবি (৪ = শুক্রবার)
# DIGEST_HOUR=10
# DIGEST_MAX_FILES=2
# OWNER_REPORT_ENABLED=true      # প্রতিদিন অ্যাডমিনকে হিসাবের মেসেজ
# OWNER_REPORT_HOUR=21

# ---------- নতুন ভিডিও হলে চ্যানেলে অটো-পোস্ট ----------
# AUTO_POST_ENABLED=false
# AUTO_POST_CHANNEL=@mychannel   # খালি = 📡 Channels-এর প্রথম চ্যানেল
# AUTO_POST_LINK_LIMIT=0         # 0 = ভিডিও নিজেই; N = “ভিডিও নিন (N বার)” লিংক
# AUTO_POST_TEXT=🎬 <b>নতুন যোগ হলো</b>{newline}{name}{newline}{newline}👇 নিচের বাটনে চাপ দিন।

# ---------- ওয়েবসাইটের কনটাক্ট ----------
# SITE_CONTACT=@myusername       # সাইট/হেল্প পেজে দেখানো যোগাযোগ
# DELIVER_FORMAT_SEPARATOR= —    # একাধিক ফাইল পাঠানোর সময় লেখার মাঝের চিহ্ন

# ---------- ড্রিপ / শিডিউল ----------
# DRIP_SEND_DELAY=0.5
# BACKUP_HOUR=4
# KEEP_BACKUPS=7

# ---------- টাইমজোন ----------
# TZ_OFFSET=6.0                  # বাংলাদেশ = 6

# ---------- প্রশ্ন/ফ্লো টাইমআউট ----------
# বট যখন প্রশ্ন করে ("চ্যানেল লিংক দিন", "কত ক্লিক?") — উত্তর না দিলে কত
# সেকেন্ড পর প্রশ্নটি নিজে থেকেই বাতিল হবে। কম রাখলে "ভুল করে লেখা টেক্সট
# বারে বারে সেভ" সমস্যা হয় না। প্যানেল থেকেও বদলানো যায়।
# FLOW_TIMEOUT_SECONDS=600        # ৬০০ = ১০ মিনিট (কমপক্ষে ৩০)

# ---------- পেজ সাইজ (বাটনের সংখ্যা) ----------
# GROUPS_PAGE_SIZE=8
# CONTENT_PAGE_SIZE=12
# USERS_PAGE_SIZE=10
# MANAGE_PAGE_SIZE=10

# ---------- ফাইল পাথ (ডিফল্ট ঠিক আছে) ----------
# DB_FILE=bot_data.sqlite3
# LEGACY_DB_FILE=bot_db.json     # পুরোনো JSON (প্রথম চালুতে অটো-ইমপোর্ট)
# BACKUP_DIR=backups
# LOG_FILE=logs/bot.log
# SESSION_STATE_FILE=bot_master.session
